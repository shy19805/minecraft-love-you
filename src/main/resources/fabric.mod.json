{
  "schemaVersion": 1,
  "id": "minecraft_love_you",
  "version": "${version}",
  "name": "我的世界爱你",
  "description": "Minecraft love you：模块化体验整合，各功能互不影响、全部可配置开关（默认全开），主动功能可配快捷键。依赖：钠 + 模组菜单 + Cloth Config。",
  "authors": [
    "minecraft_love_you"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.minecraftloveyou.WorldLovesYouMod"
    ],
    "client": [
      "com.minecraftloveyou.client.WorldLovesYouClient"
    ],
    "modmenu": [
      "com.minecraftloveyou.config.WlyModMenuPlugin"
    ]
  },
  "mixins": [
    "minecraft_love_you.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=21",
    "cloth-config": "*",
    "modmenu": "*"
  },
  "suggests": {
    "sodium": "*"
  },
  "icon": "assets/minecraft_love_you/icon.png"
}
