{
  "schemaVersion": 1,
  "id": "minecraft_love_you",
  "version": "${version}",
  "name": "我的世界爱你 · World Loves You",
  "description": "我的世界爱你（World Loves You）：模块化体验整合。每个功能互不影响、全部可配置开关，主动功能可配快捷键。\nWorld Loves You: a modular quality-of-life mod. Every feature is independent, toggleable, and key-bindable.",
  "authors": [
    "minecraft_love_you"
  ],
  "contact": {
    "homepage": "https://github.com/shy19805/minecraft-love-you",
    "issues": "https://github.com/shy19805/minecraft-love-you/issues",
    "sources": "https://github.com/shy19805/minecraft-love-you"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.minecraftloveyou.WorldLovesYouMod"
    ],
    "client": [
      "com.minecraftloveyou.client.WorldLovesYouClient"
    ],
    "modmenu": [
      "com.minecraftloveyou.config.WlyModMenuPlugin"
    ]
  },
  "mixins": [
    "minecraft_love_you.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=21",
    "cloth-config": "*",
    "modmenu": "*"
  },
  "suggests": {
    "sodium": "*"
  },
  "icon": "assets/minecraft_love_you/icon.png"
}
